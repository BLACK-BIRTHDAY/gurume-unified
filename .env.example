# Google Maps Platform Places API Key
# Enable "Places API (New)" at https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Recruit Hot Pepper Gourmet Web Service API Key (Free)
# Register at: https://webservice.recruit.co.jp/register/
HOTPEPPER_API_KEY=your_hotpepper_api_key_here

# TLS fingerprint impersonation profile for Tabelog (default: safari, options: chrome, firefox)
GURUME_IMPERSONATE=safari
